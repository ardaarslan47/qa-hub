#!/usr/bin/env bash
set -u
cd "$(git rev-parse --show-toplevel)" || exit 1

if [ "$(git config --get core.hooksPath)" != .githooks ]; then
  git config core.hooksPath .githooks 2>/dev/null
fi

if [ "$(git config --get core.hooksPath)" != .githooks ]; then
  echo "[install] core.hooksPath .githooks olarak ayarlanamadı. Hook'ları sandbox dışında, host'ta kur: .githooks/install" >&2
  exit 1
fi
