package web

import "github.com/ardaarslan47/qa-hub/internal/qahub"

templ layout(title string, project *qahub.Project) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · QA Hub</title>
			<link rel="stylesheet" href="/static/pico.classless.min.css"/>
			<link rel="stylesheet" href="/static/qa-hub.css"/>
			<script src="/static/theme.js"></script>
		</head>
		<body>
			<nav aria-label="Main">
				<a href="/projects">Projects</a>
				<a href={ templ.SafeURL(libraryPath) }>Library</a>
				if project != nil {
					<a href={ templ.SafeURL(projectPath(project.ID)) }>{ project.Name.String() }</a>
				}
			</nav>
			<main>
				{ children... }
			</main>
		</body>
	</html>
}
