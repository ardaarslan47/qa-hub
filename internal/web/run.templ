package web

import "github.com/ardaarslan47/qa-hub/internal/qahub"

templ runPage(project qahub.Project, run qahub.Run, executions []qahub.Execution) {
	@layout(run.Name.String(), &project) {
		<h1>{ run.Name.String() }</h1>
		<ul aria-label="Executions">
			for _, e := range executions {
				<li>
					<span data-testid="execution"><span data-testid="execution-title">{ e.Title.String() }</span> <span>{ statusLabel(e) }</span></span>
					<form method="post" action={ templ.SafeURL(statusPath(project.ID, run.ID, e.ID)) }>
						for _, s := range qahub.Statuses() {
							<button type="submit" name="status" value={ s.String() }>{ s.String() }</button>
						}
					</form>
					<dl>
						<dt>Priority</dt>
						<dd data-testid="execution-priority">{ e.Priority.String() }</dd>
						if e.Description.String() != "" {
							<dt>Description</dt>
							<dd data-testid="execution-description">{ e.Description.String() }</dd>
						}
						if len(e.Preconditions) > 0 {
							<dt>Preconditions</dt>
							<dd>
								for _, title := range e.Preconditions {
									<div data-testid="execution-precondition">{ title.String() }</div>
								}
							</dd>
						}
					</dl>
				</li>
			}
		</ul>
	}
}

func statusLabel(e qahub.Execution) string {
	if e.Status == nil {
		return "Untested"
	}
	return e.Status.String()
}
