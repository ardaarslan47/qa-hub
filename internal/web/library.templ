package web

import (
	"fmt"
	"slices"

	"github.com/ardaarslan47/qa-hub/internal/qahub"
)

templ libraryPage(cases []qahub.Case, form caseForm) {
	@layout("Library", nil) {
		<h1>Library</h1>
		<form method="post" action={ templ.SafeURL(libraryPath) }>
			@caseFields(form, cases, "Create case")
		</form>
		if len(cases) == 0 {
			<p>No cases yet.</p>
		} else {
			<ul aria-label="Cases">
				for _, c := range cases {
					<li><a data-testid="case-title" href={ templ.SafeURL(casePath(c.ID)) }>{ c.Title.String() }</a> <span data-testid="case-priority">{ c.Priority.String() }</span></li>
				}
			</ul>
		}
	}
}

templ casePage(c qahub.Case, preconditions []qahub.Case, choices []qahub.Case, form caseForm) {
	@layout(c.Title.String(), nil) {
		<h1>{ c.Title.String() }</h1>
		if len(preconditions) > 0 {
			<h2>Preconditions</h2>
			<ul aria-label="Preconditions">
				for _, p := range preconditions {
					<li><a href={ templ.SafeURL(casePath(p.ID)) }>{ p.Title.String() }</a></li>
				}
			</ul>
		}
		<form method="post" action={ templ.SafeURL(casePath(c.ID)) }>
			@caseFields(form, choices, "Save case")
		</form>
	}
}

templ caseFields(form caseForm, choices []qahub.Case, submit string) {
	<label for="title">Title</label>
	<input
		id="title"
		name="title"
		type="text"
		value={ form.Title }
		autofocus
		if form.TitleError != "" {
			aria-invalid="true"
			aria-describedby="title-error"
		}
	/>
	<label for="description">Description</label>
	<textarea id="description" name="description" rows="3">{ form.Description }</textarea>
	<label for="priority">Priority</label>
	<select
		id="priority"
		name="priority"
		if form.PriorityError != "" {
			aria-invalid="true"
			aria-describedby="priority-error"
		}
	>
		for _, p := range qahub.Priorities() {
			<option value={ p.String() } selected?={ p == form.Priority }>{ p.String() }</option>
		}
	</select>
	if len(choices) > 0 {
		<details open?={ form.PreconditionsError != "" }>
			<summary>Select Preconditions</summary>
			for _, c := range choices {
				<label>
					<input
						type="checkbox"
						name="preconditions"
						value={ fmt.Sprint(c.ID) }
						checked?={ slices.Contains(form.Preconditions, c.ID) }
					/>
					{ c.Title.String() }
				</label>
			}
		</details>
	}
	<button type="submit">{ submit }</button>
	if form.TitleError != "" {
		<p id="title-error" role="alert">{ form.TitleError }</p>
	}
	if form.PriorityError != "" {
		<p id="priority-error" role="alert">{ form.PriorityError }</p>
	}
	if form.PreconditionsError != "" {
		<p id="preconditions-error" role="alert">{ form.PreconditionsError }</p>
	}
}
