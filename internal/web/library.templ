package web

import "github.com/ardaarslan47/qa-hub/internal/qahub"

templ libraryPage(cases []qahub.Case, titleError string) {
	@layout("Library", nil) {
		<h1>Library</h1>
		<form method="post" action={ templ.SafeURL(libraryPath) }>
			<label for="title">Title</label>
			<input
				id="title"
				name="title"
				type="text"
				autofocus
				if titleError != "" {
					aria-invalid="true"
					aria-describedby="title-error"
				}
			/>
			<button type="submit">Create case</button>
			if titleError != "" {
				<p id="title-error" role="alert">{ titleError }</p>
			}
		</form>
		if len(cases) == 0 {
			<p>No cases yet.</p>
		} else {
			<ul aria-label="Cases">
				for _, c := range cases {
					<li>{ c.Title.String() }</li>
				}
			</ul>
		}
	}
}
