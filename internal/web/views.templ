package web

import "github.com/ardaarslan47/qa-hub/internal/qahub"

templ layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } - QA Hub</title>
		</head>
		<body>
			<header>
				<nav aria-label="Main">
					<a href="/cases">Cases</a>
					<a href="/runs">Runs</a>
				</nav>
			</header>
			<main>
				<h1>{ title }</h1>
				{ children... }
			</main>
		</body>
	</html>
}

templ casesPage(cases []qahub.Case, form formState) {
	@layout("Cases") {
		<form method="post" action="/cases">
			<label for="case-title">Title</label>
			<input id="case-title" name="title" type="text" value={ form.Value }/>
			<button type="submit">Create case</button>
			if form.Error != "" {
				<p role="alert">{ form.Error }</p>
			}
		</form>
		<ul aria-label="Cases">
			for _, c := range cases {
				<li>{ c.Title }</li>
			}
		</ul>
	}
}

templ runsPage(runs []qahub.Run, form formState) {
	@layout("Runs") {
		<form method="post" action="/runs">
			<label for="run-name">Name</label>
			<input id="run-name" name="name" type="text" value={ form.Value }/>
			<button type="submit">Start run</button>
			if form.Error != "" {
				<p role="alert">{ form.Error }</p>
			}
		</form>
		<ul aria-label="Runs">
			for _, run := range runs {
				<li><a href={ runPath(run.ID) }>{ run.Name }</a></li>
			}
		</ul>
	}
}

templ runPage(run qahub.Run, executions []qahub.Execution) {
	@layout(run.Name) {
		<table aria-label="Executions">
			<thead>
				<tr>
					<th scope="col">Case</th>
					<th scope="col">Status</th>
					<th scope="col">Record</th>
				</tr>
			</thead>
			<tbody>
				for _, e := range executions {
					<tr>
						<td>{ e.Title }</td>
						<td>{ statusLabel(e.Status) }</td>
						<td>
							<form method="post" action={ statusPath(run.ID, e.ID) }>
								<button type="submit" name="status" value="Passed">Passed</button>
								<button type="submit" name="status" value="Failed">Failed</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
	}
}
