package web

import "github.com/ardaarslan47/qa-hub/internal/domain"

type runForm struct {
	Name  string
	Error string
}

templ runsPage(runs []domain.Run, form runForm) {
	@layout("Runs") {
		<h1>Runs</h1>
		<form method="post" action="/runs">
			<label for="name">Name</label>
			<input
				id="name"
				name="name"
				type="text"
				value={ form.Name }
				if form.Error != "" {
					aria-invalid="true"
					aria-describedby="name-error"
				}
			/>
			<button type="submit">Start run</button>
			if form.Error != "" {
				<p id="name-error" role="alert">{ form.Error }</p>
			}
		</form>
		if len(runs) == 0 {
			<p>No runs yet.</p>
		}
		<ul aria-label="Runs">
			for _, r := range runs {
				<li><a href={ runPath(r.ID) }>{ r.Name }</a></li>
			}
		</ul>
	}
}

templ runPage(run domain.Run, executions []domain.Execution) {
	@layout(run.Name) {
		<h1>{ run.Name }</h1>
		<ul aria-label="Executions">
			for _, e := range executions {
				<li><span>{ e.Title }</span> <span>Untested</span></li>
			}
		</ul>
	}
}
