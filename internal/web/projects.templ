package web

import "github.com/ardaarslan47/qa-hub/internal/qahub"

templ projectsPage(projects []qahub.Project, formError string) {
	@layout("Projects", nil) {
		<h1>Projects</h1>
		<form method="post" action="/projects">
			<label for="name">Name</label>
			<input
				id="name"
				name="name"
				type="text"
				autofocus
				if formError != "" {
					aria-invalid="true"
					aria-describedby="name-error"
				}
			/>
			<button type="submit">Create project</button>
			if formError != "" {
				<p id="name-error" role="alert">{ formError }</p>
			}
		</form>
		if len(projects) == 0 {
			<p>No projects yet.</p>
		} else {
			<ul aria-label="Projects">
				for _, project := range projects {
					<li><a href={ templ.SafeURL(projectPath(project.ID)) }>{ project.Name.String() }</a></li>
				}
			</ul>
		}
	}
}

templ projectPage(project qahub.Project) {
	@layout(project.Name.String(), nil) {
		<h1>{ project.Name.String() }</h1>
		<nav aria-label="Project">
			<a href={ templ.SafeURL(casesPath(project.ID)) }>Cases</a>
			<a href={ templ.SafeURL(runsPath(project.ID)) }>Runs</a>
		</nav>
	}
}
