{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.githooks/install"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-git-bypass"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true,
    "mattpocock-skills@claude-plugins-official": true
  }
}
